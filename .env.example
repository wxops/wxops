# ─────────────────────────────────────────────────────────────────
# W'xOps IDP — environment configuration
# Copy this file to .env.local and fill in your real values
# ─────────────────────────────────────────────────────────────────

# ── Deployment ───────────────────────────────────────────────────
# If deploying to a GitHub Pages sub-path, set this.
# Example: /wxops.cloud   (leave empty for root domain)
# NEXT_PUBLIC_BASE_PATH=/wxops.cloud
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -- Required for the enterprise demo request form to actually deliver: --
# -- your Formspree form ID (formspree.io/f/<this>), from the Formspree dashboard. --
NEXT_PUBLIC_FORMSPREE_ID=
